# Copiar a .env y completar. El .env real nunca se sube al repositorio.

# ------------------------------------------------------------
# Sitio
# ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://romase.cl

# ------------------------------------------------------------
# Supabase
# ------------------------------------------------------------
# Panel de Supabase → Project Settings → API
#
# Sin estas variables el sitio funciona igual, leyendo el snapshot local
# de migration/data/. Es el modo con el que se desarrolla sin credenciales.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor. Nunca exponer en el navegador ni prefijar con NEXT_PUBLIC_.
# La usan los scripts de migración y el formulario de contacto.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# WordPress de origen (solo para la migración)
# ------------------------------------------------------------
# El catálogo se descarga por la Store API pública, así que estas
# credenciales no son necesarias para migrar productos. Sirven si se
# habilitan las Application Passwords y hace falta leer borradores.
WORDPRESS_USER=
WORDPRESS_PASSWORD=
